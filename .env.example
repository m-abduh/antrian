# ===== Tunggu production environment (docker compose) =====
# Copy ke `.env` di root repo. JANGAN commit `.env`.

# Server (wajib untuk mode production)
# Nama container mongo dipakai karena semua service satu network compose.
MONGODB_URI=mongodb://mongo:27017/tunggu
JWT_SECRET=ganti-dengan-secret-random-min-32-karakter
API_URL=https://api.tunggu.id
CORS_ORIGIN=https://tunggu.id,https://dash.tunggu.id

# Push notification
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google OAuth (opsional, untuk login Google di admin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# NextAuth (WAJIB, min 32 karakter) — admin/.env.local juga perlu ini di dev
NEXTAUTH_SECRET=ganti-dengan-secret-random-min-32-karakter
NEXTAUTH_URL=https://dash.tunggu.id

# URL publik yang dipakai browser (di-bake saat build image)
CLIENT_API_URL=https://api.tunggu.id/api
ADMIN_API_URL=https://api.tunggu.id

# Subdomain routing client (merchant.<domain>)
ROOT_DOMAIN=tunggu.id
